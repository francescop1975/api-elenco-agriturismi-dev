<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<KeyValueMapOperations continueOnError="false" enabled="true" name="KVM-GetPropertyValues">
    <DisplayName>KVM-GetPropertyValues</DisplayName>
    <MapName>api-puntozero-elenco-agriturismi</MapName>
    <Scope>environment</Scope>

    <Get assignTo="targetBasepath">
        <Key>
            <Parameter>basepath</Parameter>
        </Key>
        <DefaultValue>/</DefaultValue>
    </Get>

    <Get assignTo="targetHost">
        <Key>
            <Parameter>host</Parameter>
        </Key>
        <DefaultValue>localhost</DefaultValue>
    </Get><!-- Inserire qui le altre variabili da leggere-->
</KeyValueMapOperations>