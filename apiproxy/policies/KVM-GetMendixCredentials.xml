<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<KeyValueMapOperations continueOnError="false" enabled="true" name="KVM-GetMendixCredentials" mapIdentifier="api-elenco-agriturismi-secrets">
    <DisplayName>KVM-GetMendixCredentials</DisplayName>
    <Scope>environment</Scope>
    <ExpiryTimeInSecs>300</ExpiryTimeInSecs>
    <Get assignTo="private.mendix_username">
        <Key>
            <Parameter>mendix.username</Parameter>
        </Key>
    </Get>
    <Get assignTo="private.mendix_password">
        <Key>
            <Parameter>mendix.password</Parameter>
        </Key>
    </Get>
</KeyValueMapOperations>