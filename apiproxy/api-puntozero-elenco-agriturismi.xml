<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<APIProxy revision="1" name="api-puntozero-elenco-agriturismi">
    <!-- Nome del proxy -->
    <DisplayName>API Proxy Elenco Agriturismi</DisplayName>
    <!-- Descrizione del proxy -->
    <Description>API Proxy per la verifica degli agriturismi IAP su Mendix</Description>
    <CreatedAt>0</CreatedAt>
    <LastModifiedAt>0</LastModifiedAt>
    <!-- Basepath del proxy -->
    <BasePaths>/elenco-agriturismi/v1</BasePaths>
    <Policies>
        <Policy>AC-IPGatekeeper</Policy>
        <Policy>FC-setCors</Policy>
        <Policy>FC-verifyAccessToken</Policy><Policy>FC-securityChecks</Policy><Policy>JS-setLoggingVariables</Policy>
        <Policy>FC-setErrorRFC</Policy>
        <Policy>FC-logWriter</Policy>
        <Policy>AM-disableTargetPathSuffixAppend</Policy>
        <Policy>AM-setDynamicTargetSuffix</Policy>
        <Policy>AM-setTargetHeaderHost</Policy>
        <Policy>KVM-GetPropertyValues</Policy>
        <Policy>KVM-getRSAPrivateKey</Policy>
        <Policy>JWT-generateSignedToken</Policy>
        <Policy>RF-flowNotFound</Policy>
        <Policy>KVM-GetMendixCredentials</Policy>
		<Policy>BA-EncodeMendixAuth</Policy>
    </Policies>
    <ProxyEndpoints>
        <ProxyEndpoint>default</ProxyEndpoint>
    </ProxyEndpoints>
    <Resources>
        <Resource>jsc://set-logging-variables.js</Resource>
    </Resources>
    <TargetEndpoints>
        <TargetEndpoint>default</TargetEndpoint>
    </TargetEndpoints>
</APIProxy>