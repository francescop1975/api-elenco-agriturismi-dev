<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
    <DefaultFaultRule name="all">
        <AlwaysEnforce>true</AlwaysEnforce>
        {%- if is_pdnd -%}
        <Step>
            <Name>JS-quota-retry-after</Name>
        </Step>
        <Step>
            <Name>AM-Add-Quota-Headers</Name>
        </Step>
        <Step>
            <Name>AM-Add-Retry-After-Header</Name>
            <Condition>(quota.retry.after != null)</Condition>
        </Step>
        {%- endif -%}
        <Step>
            <Name>FC-setCors</Name>
        </Step>
        <Step>
            {%- if is_pdnd and pdnd_voucher_type == 'DPoP' -%}
            <Condition>auth_error != true and rest02_error != true</Condition>
            {%- endif -%}
            <Name>FC-setErrorRFC</Name>
        </Step>
        {%- if pdnd_integrity_rest02_enabled -%}
        <Step>
            <Condition>(message.content != null) and (message.content != "")</Condition>
            <Name>FC-integrityRest02Response</Name>
        </Step>
        <Step>
            <Condition>(message.content != null) and (message.content != "")</Condition>
            <Name>AM-Set-Signature-Headers</Name>
        </Step>
        {%- endif -%}
        <Step>
            <Name>JS-setLoggingVariables</Name>
        </Step>
        <Condition>(error.status.code!=200) or (error.status.code!=201) or (error.status.code!=202)
            or (error.status.code!=203) or (error.status.code!=204)</Condition>
    </DefaultFaultRule>
    <FaultRules />
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>AC-IPGatekeeper</Name>
            </Step>
            <Step>
                <Name>FC-setCors</Name>
            </Step>
            {%- if is_pdnd -%}
            <Step>
                <Name>JS-setLoggingVariables</Name>
            </Step>
            {%- endif -%}
            <Step>
                <Name>KVM-GetPropertyValues</Name>
            </Step>
            {%- if is_pdnd -%}
            <Step>
                <Name>KVM-GetPropertyValuesPDND</Name>
            </Step>
            <Step>
                <Name>FC-tokenVerifyPdnd</Name>
            </Step>
            <Step>
                <Name>FC-quotaVerifyPdnd</Name>
            </Step>

            {%- if pdnd_integrity_rest02_enabled -%}
            <Step>
                <Condition>(request.verb == "POST" or request.verb == "PUT" or request.verb == "DELETE") and request.content != ""</Condition>
                <Name>FC-integrityRest02Request</Name>
            </Step>
            {%- endif -%}
            {%- else -%} 
            <Step>
                <Name>FC-verifyAccessToken</Name>
            </Step> 
            {%- endif -%} 
            <Step>
                <Name>FC-securityChecks</Name>
            </Step>
        </Request>
        <Response>
            {%- if is_pdnd -%}
            <Step>
                <Name>AM-Add-Quota-Headers</Name>
            </Step>
            {%- endif -%}
        </Response>
    </PreFlow>
    <Flows>
        <!-- Inserisci qui le varie risorse -->
        <Flow name="notFound">
            <Request>
                <Step>
                    <Name>RF-flowNotFound</Name>
                </Step>
            </Request>
            <Response />
        </Flow>
    </Flows>
    <PostFlow name="PostFlow">
        <Request />
        <Response>
            <Step>
                <Name>JS-setLoggingVariables</Name>
            </Step>
            {%- if is_pdnd -%}

            {%- if pdnd_integrity_rest02_enabled -%}
            <Step>
                <Condition>(message.content != null) and (message.content != "")</Condition>
                <Name>FC-integrityRest02Response</Name>
            </Step>
            <Step>
                <Condition>(message.content != null) and (message.content != "")</Condition>
                <Name>AM-Set-Signature-Headers</Name>
            </Step>
            {%- endif -%}
            {%- endif -%}
        </Response>
    </PostFlow>
    <PostClientFlow>
        <Request />
        <Response>
            {%- if is_pdnd -%}
            <Step>
                <Name>FC-Audit-Log</Name>
            </Step>
            {%- endif -%}
            <Step>
                <Name>FC-logWriter</Name>
            </Step>
        </Response>
    </PostClientFlow>
    <HTTPProxyConnection>
        <BasePath>{{ base_path }}</BasePath>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>